<!DOCTYPE html>
<html lang="ja">
<head>
  <link rel="icon" type="image/jpeg" href="images/【FSM横】IMG_7730.jpg">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description" content="津田翔一 作品シリーズ「子ども兵士 / Tiny Soldier」— 無垢なる存在が暴力の構造に巻き込まれていく様を証言する油彩シリーズ。">
  <meta property="og:title" content="子ども兵士 / Tiny Soldier | Tsuda Shoichi">
  <meta property="og:image" content="images/【F25縦】少年兵（アフリカ）.jpg">
  <title>子ども兵士 / Tiny Soldier | Tsuda Shoichi</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Noto+Serif+JP:wght@200;300;400&display=swap" rel="stylesheet">

  <style>
    /* ════════════════════════════════════════
       DESIGN TOKENS
    ════════════════════════════════════════ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:          #080808;
      --fg:          #ede9e4;
      --text:        #e8e4db;
      --text-muted:  rgba(232,228,219,0.55);
      --text-dim:    rgba(232,228,219,0.35);
      --border:      rgba(232,228,219,0.12);
      --border-mid:  rgba(232,228,219,0.25);
      --accent:      #cbbfb0;
      --accent-dim:  rgba(203,191,176,0.35);
      --muted-col:   #7a746e;
      --en: 'Cormorant Garamond', serif;
      --jp: 'Noto Serif JP', serif;
      --ease-expo:   cubic-bezier(0.16, 1, 0.3, 1);
      --ease-img:    cubic-bezier(0.165, 0.84, 0.44, 1);
      --px:          clamp(20px, 5vw, 64px);
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--jp);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* ─── VIDEO BG ─── */
    .works-video-bg {
      position: fixed; inset: 0; z-index: -1;
      pointer-events: none; opacity: 1;
    }
    .works-video-bg video {
      width: 100%; height: 100%;
      object-fit: cover; opacity: 0.13;
      display: block; filter: grayscale(100%);
    }
    .works-video-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to bottom, rgba(8,8,8,0.6) 0%, rgba(8,8,8,0.97) 100%);
    }

    /* ════════════════════════════════════════
       NAV
    ════════════════════════════════════════ */
    nav {
      position: sticky; top: 0; z-index: 200;
      display: flex; align-items: center; justify-content: space-between;
      padding: clamp(14px,3vw,36px) var(--px);
      border-bottom: 0.5px solid var(--border);
      background: rgba(13,13,11,0.94);
      backdrop-filter: blur(8px);
    }
    .nav-logo {
      font-family: var(--en);
      font-size: clamp(0.7rem,2.5vw,0.9rem);
      letter-spacing: 0.3em; font-weight: 300;
      color: var(--accent); text-decoration: none;
      text-transform: uppercase; transition: opacity 0.4s ease;
    }
    .nav-logo:hover { opacity: 0.5; }
    .nav-links { display: flex; gap: 2rem; list-style: none; }
    .nav-links a {
      font-family: var(--en);
      font-size: clamp(0.55rem,1.5vw,0.72rem);
      letter-spacing: 0.25em; color: var(--muted-col);
      text-decoration: none; text-transform: uppercase;
      transition: color 0.3s ease;
    }
    .nav-links a:hover { color: var(--accent); }
    .nav-cta {
      font-family: var(--en);
      font-size: clamp(0.55rem,1.5vw,0.65rem);
      letter-spacing: 0.25em; text-transform: uppercase;
      border: 0.5px solid rgba(184,168,152,0.4);
      padding: 0.55rem 1.4rem; color: var(--accent);
      text-decoration: none; transition: background 0.25s, color 0.25s;
    }
    .nav-cta:hover { background: rgba(184,168,152,0.08); color: var(--fg); }
    .nav-hamburger {
      display: none; background: none; border: none;
      cursor: pointer; padding: 4px;
    }
    .nav-hamburger span {
      display: block; width: 22px; height: 0.5px;
      background: var(--accent); margin: 6px 0; transition: all 0.25s;
    }

    /* ════════════════════════════════════════
       SERIES HERO
    ════════════════════════════════════════ */
    .series-hero {
      position: relative; overflow: hidden;
      min-height: 90vh; min-height: 90svh;
      display: flex; flex-direction: column;
      justify-content: flex-end;
      padding: clamp(80px,12vh,140px) var(--px) clamp(52px,9vh,100px);
    }

    /* 背景にゴーストテキスト */
    .series-hero-ghost {
      position: absolute; inset: 0; z-index: 0;
      display: flex; align-items: center; justify-content: flex-end;
      padding-right: var(--px);
      pointer-events: none; user-select: none;
      font-family: var(--en);
      font-size: clamp(7rem,22vw,24rem);
      font-weight: 300; letter-spacing: 0.05em;
      color: transparent;
      -webkit-text-stroke: 1px rgba(255,255,255,0.035);
      white-space: nowrap; line-height: 1;
      opacity: 0; transform: translateY(12px);
      animation: ghostRise 2.2s var(--ease-expo) 1.2s forwards;
    }

    .series-hero-inner {
      position: relative; z-index: 1;
      max-width: 900px;
    }

    .series-eyebrow {
      font-family: var(--en);
      font-size: clamp(0.55rem,1.6vw,0.68rem);
      letter-spacing: 0.42em; color: var(--muted-col);
      text-transform: uppercase; margin-bottom: clamp(14px,3vh,36px);
      overflow: hidden;
    }
    .series-eyebrow span {
      display: inline-block; opacity: 0; transform: translateY(100%);
      animation: clipUp 0.9s var(--ease-expo) 0.4s forwards;
    }

    .series-title-en {
      font-family: var(--en);
      font-size: clamp(4rem,12vw,11rem);
      font-weight: 300; letter-spacing: 0.08em; line-height: 0.9;
      color: var(--fg);
      overflow: hidden;
    }
    .series-title-en span {
      display: block; opacity: 0; transform: translateY(0.65em) skewY(2.5deg);
      animation: charReveal 1s var(--ease-expo) 0.6s forwards;
    }
    .series-title-jp {
      font-family: var(--jp); font-weight: 200;
      font-size: clamp(1rem,3vw,2rem);
      letter-spacing: 0.22em; color: rgba(237,233,228,0.45);
      margin-top: 0.6em; overflow: hidden;
    }
    .series-title-jp span {
      display: block; opacity: 0; transform: translateY(0.5em);
      animation: charReveal 0.9s var(--ease-expo) 0.85s forwards;
    }

    .series-sub {
      margin-top: clamp(18px,3.5vh,52px);
      font-family: var(--jp); font-weight: 200;
      font-size: clamp(0.78rem,2vw,1rem);
      letter-spacing: 0.2em; color: var(--muted-col);
      overflow: hidden;
    }
    .series-sub span {
      display: inline-block; opacity: 0; transform: translateY(100%);
      animation: clipUp 1s var(--ease-expo) 1.1s forwards;
    }

    .series-rule {
      margin-top: clamp(14px,2.5vh,32px);
      width: 0; height: 1px; background: rgba(255,255,255,0.14);
      animation: drawLine 1.2s var(--ease-expo) 1.5s forwards;
    }

    .scroll-cue {
      position: absolute; bottom: clamp(24px,5vh,60px); right: var(--px);
      display: flex; flex-direction: column; align-items: center; gap: 10px;
      opacity: 0; animation: fadeOnly 1s ease 2.2s forwards;
    }
    .scroll-cue-line {
      width: 1px; height: 52px;
      background: linear-gradient(to bottom, var(--muted-col), transparent);
      animation: pulseBar 2.5s ease-in-out 2.5s infinite;
    }
    .scroll-cue span {
      font-family: var(--en); font-size: 0.54rem;
      letter-spacing: 0.38em; color: var(--muted-col);
      text-transform: uppercase; writing-mode: vertical-rl;
    }

    /* ════════════════════════════════════════
       CONCEPT
    ════════════════════════════════════════ */
    .concept-section {
      display: grid;
      grid-template-columns: clamp(80px,14vw,180px) 1fr;
      gap: clamp(2rem,4vw,6rem);
      padding: clamp(60px,10vh,120px) var(--px);
      border-top: 0.5px solid var(--border);
      align-items: start;
    }
    .concept-sidebar {
      display: flex; flex-direction: column; gap: 1.2rem;
      padding-top: 0.3rem;
    }
    .concept-sidebar-label {
      font-family: var(--en);
      font-size: clamp(0.55rem,1.3vw,0.66rem);
      letter-spacing: 0.38em; color: var(--muted-col);
      text-transform: uppercase; line-height: 1;
    }
    .concept-sidebar-num {
      font-family: var(--en);
      font-size: clamp(2.5rem,6vw,5rem);
      font-weight: 300; line-height: 1;
      color: rgba(255,255,255,0.04); letter-spacing: -0.02em;
    }
    .concept-main {}
    .concept-credit {
      font-family: var(--en);
      font-size: 0.62rem; letter-spacing: 0.22em;
      color: rgba(237,233,228,0.26); text-transform: uppercase;
      margin-bottom: 2rem;
    }
    .concept-lead {
      font-family: var(--jp); font-weight: 200;
      font-size: clamp(1.15rem,2.8vw,1.65rem);
      letter-spacing: 0.04em; line-height: 1.85;
      color: rgba(237,233,228,0.88); margin-bottom: 2.5rem;
    }
    .concept-text {
      font-size: clamp(0.88rem,1.7vw,1.02rem); font-weight: 300;
      line-height: 2.2; color: var(--text-muted);
      letter-spacing: 0.035em; margin-bottom: 1.8rem;
    }
    .concept-text:last-child { margin-bottom: 0; }
    .concept-text em {
      font-style: normal; color: var(--accent);
      border-bottom: 0.5px solid var(--border-mid); padding-bottom: 2px;
    }

    /* ─── コンセプト内 キーワードパネル ─── */
    .concept-keywords {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      margin-top: 4rem;
      border: 0.5px solid var(--border);
    }
    .concept-kw {
      padding: 2rem 1.75rem;
      background: rgba(255,255,255,0.015);
      transition: background 0.35s ease, transform 0.35s var(--ease-expo);
    }
    .concept-kw:hover {
      background: rgba(255,255,255,0.04);
      transform: translateY(-3px);
    }
    .concept-kw-num {
      font-family: var(--en); font-size: 0.62rem;
      letter-spacing: 0.28em; color: rgba(237,233,228,0.2);
      text-transform: uppercase; margin-bottom: 1rem;
    }
    .concept-kw-title {
      font-size: clamp(0.88rem,1.5vw,1rem); font-weight: 300;
      color: var(--fg); letter-spacing: 0.06em; margin-bottom: 0.8rem;
    }
    .concept-kw-desc {
      font-size: clamp(0.76rem,1.2vw,0.86rem); font-weight: 300;
      line-height: 1.85; color: var(--text-muted);
    }

    /* ════════════════════════════════════════
       WORKS — 個別作品
    ════════════════════════════════════════ */
    .works-section {
      padding: 0 var(--px) clamp(80px,12vh,160px);
    }

    /* セクション見出し */
    .works-header {
      display: flex; align-items: flex-end;
      justify-content: space-between;
      padding-bottom: clamp(18px,3vw,40px);
      border-bottom: 0.5px solid var(--border);
      margin-bottom: clamp(48px,8vh,96px);
    }
    .works-header-label {
      font-family: var(--en);
      font-size: clamp(0.55rem,1.4vw,0.68rem);
      letter-spacing: 0.4em; color: var(--muted-col);
      text-transform: uppercase;
    }
    .works-header-count {
      font-family: var(--en);
      font-size: clamp(2rem,5vw,4.5rem);
      font-weight: 300; letter-spacing: -0.03em;
      color: rgba(255,255,255,0.04); line-height: 1;
    }

    /* 作品アイテム */
    .work-item {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem,5vw,6rem);
      padding: clamp(48px,8vh,100px) 0;
      border-bottom: 0.5px solid var(--border);
      align-items: center;
    }
    .work-item:last-child { border-bottom: none; }

    /* 偶数番目は左右反転 */
    .work-item.reverse .work-img-col  { order: 2; }
    .work-item.reverse .work-text-col { order: 1; }

    /* ─── 画像カラム ─── */
    .work-img-col {}
    .work-img-frame {
      position: relative; overflow: hidden;
      background: #0c0c0b; cursor: zoom-in;
    }
    .work-img-frame.portrait  { aspect-ratio: 3/4; }
    .work-img-frame.landscape { aspect-ratio: 4/3; }
    .work-img-frame.square    { aspect-ratio: 1/1; }

    .work-img-frame img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      filter: grayscale(30%) brightness(0.78);
      transform: scale(1.03);
      transition: filter 1.1s var(--ease-img), transform 1.4s var(--ease-img);
    }
    .work-img-frame:hover img {
      filter: grayscale(0%) brightness(0.96);
      transform: scale(1.0);
    }

    /* グラデオーバーレイ */
    .work-img-frame::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(to top,
        rgba(8,8,8,0.72) 0%, rgba(8,8,8,0.12) 40%, transparent 100%);
      opacity: 0; transition: opacity 0.45s ease;
    }
    .work-img-frame:hover::after { opacity: 1; }

    /* アクセントライン（左辺） */
    .work-img-frame::before {
      content: '';
      position: absolute; left: 0; bottom: 0; z-index: 2;
      width: 2px; height: 0; background: var(--accent);
      transition: height 0.6s var(--ease-expo);
    }
    .work-img-frame:hover::before { height: 50%; }

    /* ズームヒント */
    .work-zoom-hint {
      position: absolute; bottom: 1.2rem; right: 1.2rem; z-index: 3;
      font-family: var(--en); font-size: 0.56rem; letter-spacing: 0.22em;
      color: rgba(237,233,228,0.65); text-transform: uppercase;
      opacity: 0; transform: translateY(5px);
      transition: opacity 0.4s ease, transform 0.4s var(--ease-expo);
      pointer-events: none;
    }
    .work-img-frame:hover .work-zoom-hint { opacity: 1; transform: translateY(0); }

    /* ─── テキストカラム ─── */
    .work-text-col {}

    .work-index {
      font-family: var(--en); font-size: 0.62rem;
      letter-spacing: 0.32em; color: rgba(237,233,228,0.25);
      text-transform: uppercase; margin-bottom: 1.8rem;
      display: flex; align-items: center; gap: 1rem;
    }
    .work-index::after {
      content: ''; width: 40px; height: 0.5px;
      background: rgba(255,255,255,0.1);
    }

    .work-year {
      font-family: var(--en);
      font-size: clamp(0.65rem,1.5vw,0.8rem);
      letter-spacing: 0.28em; color: var(--muted-col);
      display: block; margin-bottom: 0.8rem;
    }

    .work-title-ja {
      font-family: var(--jp); font-weight: 200;
      font-size: clamp(1.6rem,4vw,3rem);
      letter-spacing: 0.06em; line-height: 1.2;
      color: var(--fg); margin-bottom: 0.35rem;
    }
    .work-title-en {
      font-family: var(--en); font-style: italic;
      font-size: clamp(0.9rem,2.2vw,1.4rem);
      letter-spacing: 0.12em; color: var(--accent);
      display: block; margin-bottom: 2rem;
    }

    .work-spec {
      font-family: var(--en);
      font-size: clamp(0.58rem,1.2vw,0.68rem);
      letter-spacing: 0.18em; color: rgba(237,233,228,0.3);
      text-transform: uppercase; line-height: 2;
      border-left: 1px solid rgba(255,255,255,0.1);
      padding-left: 1.1rem; margin-bottom: 2.5rem;
    }

    .work-commentary-label {
      font-family: var(--en);
      font-size: 0.58rem; letter-spacing: 0.3em;
      color: var(--muted-col); text-transform: uppercase;
      margin-bottom: 1.2rem;
      display: flex; align-items: center; gap: 0.8rem;
    }
    .work-commentary-label::after {
      content: ''; flex: 1; height: 0.5px;
      background: rgba(255,255,255,0.08); max-width: 56px;
    }

    .work-commentary {
      font-size: clamp(0.86rem,1.6vw,0.98rem); font-weight: 300;
      line-height: 2.15; color: var(--text-muted);
      letter-spacing: 0.03em;
    }
    .work-commentary p + p { margin-top: 1.2em; }
    .work-commentary em {
      font-style: normal; color: var(--accent);
      border-bottom: 0.5px solid var(--border-mid); padding-bottom: 1px;
    }

    /* ─── LIGHTBOX ─── */
    .lb {
      position: fixed; inset: 0; z-index: 500;
      background: rgba(5,5,5,0.97);
      display: none; align-items: center; justify-content: center;
      cursor: zoom-out; padding: clamp(20px,5vw,60px);
      opacity: 0; transition: opacity 0.35s ease;
    }
    .lb.open  { display: flex; }
    .lb.vis   { opacity: 1; }
    .lb img {
      max-width: 100%; max-height: 90vh; object-fit: contain;
      transform: scale(0.96);
      transition: transform 0.45s var(--ease-expo);
    }
    .lb.vis img { transform: scale(1); }
    .lb-close {
      position: absolute; top: 1.5rem; right: 2rem;
      font-family: var(--en); font-size: 0.6rem; letter-spacing: 0.22em;
      color: rgba(237,233,228,0.4); text-transform: uppercase;
      background: none; border: none; cursor: pointer;
      display: flex; align-items: center; gap: 0.5rem; transition: color 0.2s;
    }
    .lb-close:hover { color: var(--fg); }
    .lb-close-x { font-size: 1.5rem; font-weight: 100; line-height: 1; }

    /* ════════════════════════════════════════
       BACK LINK
    ════════════════════════════════════════ */
    .back-wrap {
      text-align: center;
      padding: clamp(40px,7vh,80px) var(--px) clamp(20px,4vh,40px);
    }
    .back-link {
      display: inline-flex; align-items: center; gap: 1rem;
      font-family: var(--en); font-size: 0.64rem;
      letter-spacing: 0.25em; color: var(--muted-col);
      text-transform: uppercase; text-decoration: none;
      transition: color 0.3s;
    }
    .back-link-arrow { font-size: 1rem; transition: transform 0.3s; }
    .back-link:hover { color: var(--accent); }
    .back-link:hover .back-link-arrow { transform: translateX(-4px); }

    /* ════════════════════════════════════════
       CONTACT & FOOTER
    ════════════════════════════════════════ */
    .contact-section {
      padding: 7rem 2.5rem; text-align: center;
      border-bottom: 0.5px solid var(--border);
      border-top: 0.5px solid var(--border);
      background: var(--bg); position: relative; z-index: 2;
    }
    .section-label {
      font-family: var(--en);
      font-size: clamp(0.55rem,1.5vw,0.65rem);
      letter-spacing: 0.28em; color: var(--muted-col);
      text-transform: uppercase; margin-bottom: 3.5rem;
      display: flex; align-items: center; justify-content: center; gap: 1rem;
    }
    .section-label::after,
    .section-label::before {
      content: ''; width: 48px; height: 0.5px; background: rgba(232,228,219,0.2);
    }
    .section-heading {
      font-family: var(--jp);
      font-size: clamp(1.75rem,4vw,3.25rem);
      font-weight: 300; line-height: 1.2; color: var(--text);
      margin-bottom: 2rem; letter-spacing: -0.01em;
    }
    .contact-body-text {
      font-size: 14px; color: var(--text-muted);
      margin: 0 auto 2.75rem; max-width: 400px; line-height: 1.9;
    }
    .contact-btn {
      display: inline-block; font-family: var(--en);
      font-size: clamp(0.55rem,1.5vw,0.65rem);
      letter-spacing: 0.22em; text-transform: uppercase;
      border: 0.5px solid rgba(184,168,152,0.45);
      padding: 0.9rem 2.75rem; color: var(--accent);
      text-decoration: none; transition: background 0.2s, color 0.2s;
    }
    .contact-btn:hover { background: rgba(184,168,152,0.07); color: var(--fg); }

    footer {
      padding: 2.75rem 2.5rem;
      display: flex; justify-content: space-between;
      align-items: center; flex-wrap: wrap; gap: 1rem;
      background: var(--bg); position: relative; z-index: 2;
    }
    .footer-logo {
      font-family: var(--jp); font-size: 16px; font-weight: 300;
      color: rgba(232,228,219,0.35); letter-spacing: 0.05em;
    }
    .footer-copy {
      font-family: var(--en); font-size: 10px;
      color: rgba(232,228,219,0.2); letter-spacing: 0.14em;
    }

    /* ════════════════════════════════════════
       REVEAL
    ════════════════════════════════════════ */
    .reveal {
      opacity: 0; transform: translateY(24px);
      transition: opacity 1s var(--ease-expo), transform 1s var(--ease-expo);
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    /* ════════════════════════════════════════
       KEYFRAMES
    ════════════════════════════════════════ */
    @keyframes clipUp     { to { opacity:1; transform:translateY(0); } }
    @keyframes charReveal { to { opacity:1; transform:translateY(0) skewY(0deg); } }
    @keyframes ghostRise  { to { opacity:1; transform:translateY(0); } }
    @keyframes fadeOnly   { to { opacity:1; } }
    @keyframes drawLine   { to { width: clamp(48px,12vw,160px); } }
    @keyframes pulseBar   {
      0%,100% { opacity:0.3; } 50% { opacity:1; }
    }

    /* ════════════════════════════════════════
       RESPONSIVE
    ════════════════════════════════════════ */
