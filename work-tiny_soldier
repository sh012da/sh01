<script>
  /* ── Nav ── */
  function toggleMenu() {
    var links = document.getElementById('nav-links');
    var btn   = document.getElementById('nav-cta-btn');
    links.classList.toggle('open');
    btn.style.display = links.classList.contains('open') ? 'none' : '';
  }
  function closeMenu() {
    document.getElementById('nav-links').classList.remove('open');
    document.getElementById('nav-cta-btn').style.display = '';
  }

  /* ── Reveal ── */
  document.addEventListener('DOMContentLoaded', function() {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.08 });
    document.querySelectorAll('.reveal').forEach(function(el) { io.observe(el); });
  });

  /* ── Lightbox ── */
  function openLB(frame) {
    var img = frame.querySelector('img');
    var lb  = document.getElementById('lb');
    document.getElementById('lb-img').src = img.src;
    document.getElementById('lb-img').alt = img.alt;
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(function() {
      requestAnimationFrame(function() { lb.classList.add('vis'); });
    });
  }
  function closeLB() {
    var lb = document.getElementById('lb');
    lb.classList.remove('vis');
    setTimeout(function() {
      lb.classList.remove('open');
      document.body.style.overflow = '';
    }, 350);
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeLB();
  });
</script>
