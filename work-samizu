}
.scroll-cue .bar{width:1px;height:46px;background:var(--line);position:relative;overflow:hidden;}
.scroll-cue .bar::after{
  content:"";position:absolute;top:-100%;left:0;width:100%;height:100%;background:var(--ink);
  animation:scrollBar 2s ease-in-out infinite;
}
@keyframes scrollBar{0%{top:-100%;}60%{top:100%;}100%{top:100%;}}

/* ---------- section shells ---------- */
section{padding:120px 5vw;position:relative;}
.section-tight{padding-top:70px;padding-bottom:70px;}
.eyebrow{
  font-size:12px;letter-spacing:.3em;color:var(--accent-soft);margin-bottom:18px;display:block;
}
h2.section-title{
  font-family:var(--serif);font-weight:700;
  font-size:clamp(26px,3.6vw,44px);line-height:1.5;margin:0 0 28px;
}
.lead-text{
  max-width:760px;color:var(--ink-dim);font-size:16px;line-height:2.05;
}
.reveal{opacity:0;transform:translateY(36px);transition:opacity .9s var(--ease), transform .9s var(--ease);}
.reveal.is-visible{opacity:1;transform:translateY(0);}
.reveal-delay-1.is-visible{transition-delay:.12s;}
.reveal-delay-2.is-visible{transition-delay:.24s;}
.reveal-delay-3.is-visible{transition-delay:.36s;}

/* ---------- statement / intro ---------- */
.intro{
  border-bottom:1px solid var(--line);
}
.intro-quote{
  font-family:var(--serif);font-weight:600;
  font-size:clamp(22px,3.2vw,36px);
  line-height:1.85;max-width:880px;
  margin:0 0 50px;
  color:#fff;
}
.intro-quote .accent{color:var(--accent);}
.intro-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:50px;margin-top:60px;
}
.intro-grid .card{border-top:1px solid var(--line);padding-top:22px;}
.intro-grid .card .num{font-family:var(--serif);font-size:13px;color:var(--accent-soft);letter-spacing:.2em;}
.intro-grid .card h3{font-family:var(--serif);font-size:18px;margin:14px 0 10px;}
.intro-grid .card p{font-size:13.5px;color:var(--ink-dim);margin:0;}
@media(max-width:780px){.intro-grid{grid-template-columns:1fr;gap:34px;}}

/* ---------- info strip ---------- */
.info-strip{
  display:grid;grid-template-columns:repeat(4,1fr);
  border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  padding:0;
}
.info-strip div{
  padding:30px 5vw;border-right:1px solid var(--line);
}
.info-strip div:last-child{border-right:none;}
.info-strip .label{font-size:11px;letter-spacing:.2em;color:var(--ink-dim);margin-bottom:8px;display:block;}
.info-strip .value{font-size:14.5px;color:var(--ink);}
@media(max-width:880px){
  .info-strip{grid-template-columns:1fr 1fr;}
  .info-strip div:nth-child(2n){border-right:none;}
  .info-strip div{border-bottom:1px solid var(--line);}
}

/* ---------- full-bleed panorama figures ---------- */
.figure-full{
  margin:0;width:100%;overflow:hidden;background:var(--bg-soft);
}
.figure-full img{
  width:100%;height:auto;display:block;
  transition:transform 1.4s var(--ease);
}
.figure-full:hover img{transform:scale(1.02);}
.figure-cap{
  display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;
  padding:18px 5vw 0;font-size:12.5px;color:var(--ink-dim);letter-spacing:.04em;
}
.figure-cap .idx{color:var(--accent-soft);letter-spacing:.2em;}

/* ---------- narrative split sections ---------- */
.split{
  display:grid;grid-template-columns:1fr 1fr;gap:6vw;align-items:center;
}
.split.reverse .split-media{order:2;}
.split-media{position:relative;border-radius:2px;overflow:hidden;}
.split-media img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s var(--ease);}
.split-media:hover img{transform:scale(1.04);}
.split-text h3{
  font-family:var(--serif);font-size:clamp(20px,2.6vw,30px);line-height:1.7;margin:0 0 22px;
}
.split-text p{color:var(--ink-dim);font-size:15px;line-height:2;margin:0 0 16px;}
@media(max-width:900px){
  .split, .split.reverse{grid-template-columns:1fr;}
  .split.reverse .split-media{order:0;}
}

/* ---------- mosaic gallery ---------- */
.gallery-head{margin-bottom:54px;}
.mosaic{
  display:grid;
  grid-template-columns:repeat(6,1fr);
  gap:14px;
}
.mosaic figure{
  margin:0;position:relative;overflow:hidden;background:var(--bg-soft);
  border-radius:2px;cursor:pointer;
}
.mosaic figure img{
  width:100%;height:100%;object-fit:cover;
  transition:transform 1s var(--ease), filter .6s;
}
.mosaic figure:hover img{transform:scale(1.07);}
.mosaic figure figcaption{
  position:absolute;left:0;right:0;bottom:0;
  padding:14px 16px;font-size:11.5px;letter-spacing:.08em;color:#fff;
  background:linear-gradient(to top, rgba(0,0,0,.65), rgba(0,0,0,0));
  opacity:0;transform:translateY(8px);
  transition:opacity .35s, transform .35s;
}
.mosaic figure:hover figcaption{opacity:1;transform:translateY(0);}
.mosaic figure.w2{grid-column:span 3;aspect-ratio:4/3;}
.mosaic figure.w3{grid-column:span 4;aspect-ratio:16/9;}
.mosaic figure.w-sm{grid-column:span 2;aspect-ratio:3/4;}
.mosaic figure.wfull{grid-column:span 6;aspect-ratio:21/8;}
@media(max-width:900px){
  .mosaic{grid-template-columns:repeat(2,1fr);}
  .mosaic figure.w2,.mosaic figure.w3,.mosaic figure.w-sm,.mosaic figure.wfull{grid-column:span 2;aspect-ratio:4/3;}
}

/* ---------- artifact strip (relics) ---------- */
.relics{
  border-top:1px solid var(--line);
}
.relics-row{
  display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:48px;
}
.relics-row figure{margin:0;overflow:hidden;border-radius:2px;background:var(--bg-soft);}
.relics-row img{width:100%;aspect-ratio:4/5;object-fit:cover;transition:transform 1s var(--ease);}
.relics-row figure:hover img{transform:scale(1.06);}
.relics-row figcaption{padding:12px 2px 0;font-size:12px;color:var(--ink-dim);letter-spacing:.04em;}
@media(max-width:880px){.relics-row{grid-template-columns:1fr 1fr;}}

/* ---------- closing statement ---------- */
.closing{
