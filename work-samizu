}
.series-nav a:first-child{border-right:1px solid var(--line);}
.series-nav a:hover{background:var(--bg-soft);}
.series-nav .dir{font-size:11px;letter-spacing:.25em;color:var(--ink-dim);}
.series-nav .ttl{font-family:var(--serif);font-size:18px;}
.series-nav a.next{text-align:right;align-items:flex-end;}
@media(max-width:700px){.series-nav{flex-direction:column;}.series-nav a:first-child{border-right:none;border-bottom:1px solid var(--line);}}

/* ---------- contact (shared) ---------- */
.contact{
