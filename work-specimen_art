      }
      .gi:nth-child(1) {
        grid-column: 1/3 !important;
        aspect-ratio: 16/9 !important;
      }
    }

    @media (max-width: 900px) {
      .work-item,
      .work-item.reverse {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }
      .work-item.reverse .work-img-col,
