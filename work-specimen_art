      .concept-keywords { grid-template-columns: 1fr; }

      .gallery-grid { grid-template-columns: 1fr 1fr; gap: 6px; }
      .gi { aspect-ratio: 3/4 !important; }
      .gi:nth-child(1) { grid-column: 1/3 !important; aspect-ratio: 16/9 !important; }

      .gi-title, .gi-en { opacity: 1 !important; transform: translateY(0) !important; }
      .gi-label { transform: translateY(0) !important; }
      .gi img { filter: grayscale(15%) brightness(0.80); }

      .works-detail-header { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
      .scroll-cue { display: none; }
      .contact-section { padding: 5rem 1.5rem; }
      footer { padding: 2rem 1.5rem; }
    }

    @media (max-width: 480px) {
      .gallery-grid { grid-template-columns: 1fr; gap: 4px; }
      .gi, .gi:nth-child(1) {
        grid-column: auto !important;
        aspect-ratio: 3/2 !important;
      }
