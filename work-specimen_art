<script>
  /* ── Nav ── */
  function toggleMenu() {
    var links = document.getElementById('nav-links');
    var btn   = document.getElementById('nav-cta-btn');
    links.classList.toggle('open');
    btn.style.display = links.classList.contains('open') ? 'none' : '';
  }
  function closeMenu() {
    document.getElementById('nav-links').classList.remove('open');
    document.getElementById('nav-cta-btn').style.display = '';
  }

  /* ── Reveal ── */
  document.addEventListener('DOMContentLoaded', function() {
    var revealObs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          revealObs.unobserve(e.target);
        }
      });
    }, { threshold: 0.08 });
    document.querySelectorAll('.reveal').forEach(function(el) {
      revealObs.observe(el);
    });

    /* ── Gallery grid フェードイン ── */
    var gridObs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          e.target.classList.add('vis');
          gridObs.unobserve(e.target);
        }
      });
    }, { threshold: 0.06 });
    document.querySelectorAll('.gi').forEach(function(el, i) {
      el.style.setProperty('--gd', (i % 4 * 80) + 'ms');
      gridObs.observe(el);
    });
  });

  /* ── Lightbox（グリッドカード用） ── */
  function openLB(card) {
    var src = card.dataset.src;
    var alt = card.dataset.alt || '';
    _showLB(src, alt);
  }
  function openLBDirect(src, alt) {
    _showLB(src, alt || '');
  }
  function _showLB(src, alt) {
    var lb = document.getElementById('lb');
    var img = document.getElementById('lb-img');
    img.src = src;
    img.alt = alt;
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(function() {
      requestAnimationFrame(function() { lb.classList.add('vis'); });
    });
  }
  function closeLB() {
    var lb = document.getElementById('lb');
    lb.classList.remove('vis');
    setTimeout(function() {
      lb.classList.remove('open');
      document.body.style.overflow = '';
    }, 350);
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeLB();
  });
</script>
