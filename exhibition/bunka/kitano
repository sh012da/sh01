<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Exhibition — 左美都の記憶と地脈 | 津田翔一</title>
  <meta name="description" content="文化庁メディア芸術クリエイター育成支援事業採択企画展示「左美都の記憶と地脈」長野展 — 津田翔一" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Noto+Serif+JP:wght@200;300;400;500&display=swap" rel="stylesheet" />

  <style>
    /* ─── Design Tokens ─────────────────────────────── */
    :root {
      --bg:        #080808;
      --surface:   #0f0f0f;
      --border:    rgba(184,149,90,0.18);
      --gold:      #b8955a;
      --gold-dim:  rgba(184,149,90,0.45);
      --text:      rgba(240,235,225,0.88);
      --text-dim:  rgba(240,235,225,0.48);
      --text-faint:rgba(240,235,225,0.28);
      --serif-en:  'Cormorant Garamond', Georgia, serif;
      --serif-jp:  'Noto Serif JP', serif;
      --ease:      cubic-bezier(0.16, 1, 0.3, 1);
      --px:        clamp(24px, 5vw, 48px);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; overflow-x: hidden; }

    body {
      background: var(--bg); color: var(--text);
      font-family: var(--serif-jp); font-weight: 300; line-height: 1.8;
      -webkit-font-smoothing: antialiased;
      padding-left: env(safe-area-inset-left); padding-right: env(safe-area-inset-right);
      overflow-x: hidden;
    }
    body.is-locked { overflow: hidden; }

    /* ─── Header ────────────────────────────────────── */
    nav#top-nav {
      position: fixed; top: 0; left: 0; width: 100%; z-index: 1000;
      display: flex; align-items: center; justify-content: space-between;
      padding: clamp(16px, 3vw, 32px) var(--px);
      background: transparent; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      border-bottom: 0.5px solid transparent;
      transition: background 0.4s ease, border-color 0.4s ease, padding 0.4s ease;
    }
    nav#top-nav.scrolled {
      background: rgba(8, 8, 8, 0.85); border-color: var(--border);
      padding: clamp(12px, 2vw, 24px) var(--px);
    }
    .nav-logo-unified {
      font-family: var(--serif-en); font-size: clamp(0.75rem, 2.5vw, 0.9rem);
      letter-spacing: 0.25em; font-weight: 300; color: var(--gold);
      text-transform: uppercase; text-decoration: none; transition: opacity 0.4s ease;
      position: relative; z-index: 1001;
    }
    .nav-logo-unified:hover { opacity: 0.6; }
    
    .nav-links { display: flex; gap: 2.5rem; list-style: none; }
    .nav-links a {
      font-family: var(--serif-en); font-size: clamp(0.6rem, 1.2vw, 0.72rem);
      letter-spacing: 0.2em; text-decoration: none;
      color: var(--text); opacity: 0.6; text-transform: uppercase; transition: opacity 0.3s ease, color 0.3s ease;
    }
    .nav-links a:hover { opacity: 1; color: var(--gold); }
    
    .nav-cta {
      font-family: var(--serif-en); font-size: clamp(0.6rem, 1.2vw, 0.65rem);
      letter-spacing: 0.2em; text-decoration: none; text-transform: uppercase;
      border: 0.5px solid rgba(184,149,90,0.35); padding: 0.6rem 1.6rem;
      color: var(--gold); transition: background 0.3s, color 0.3s; border-radius: 2px;
    }
    .nav-cta:hover { background: var(--gold); color: var(--bg); }
    
    .nav-hamburger {
      display: none; background: none; border: none; cursor: pointer; padding: 4px;
      position: relative; z-index: 1001; width: 32px; height: 20px;
    }
    .nav-hamburger span {
      display: block; position: absolute; left: 0; width: 100%; height: 1px;
      background: var(--gold); transition: transform 0.4s var(--ease), opacity 0.4s var(--ease), top 0.4s var(--ease);
    }
    .nav-hamburger span:nth-child(1) { top: 0px; }
    .nav-hamburger span:nth-child(2) { top: 9px; }
    .nav-hamburger span:nth-child(3) { top: 18px; }
    .nav-hamburger.is-active span:nth-child(1) { top: 9px; transform: rotate(45deg); }
    .nav-hamburger.is-active span:nth-child(2) { opacity: 0; }
    .nav-hamburger.is-active span:nth-child(3) { top: 9px; transform: rotate(-45deg); }

    /* ─── Page Navigation (In-page) ─────────────────── */
    .page-nav {
      position: fixed; right: clamp(16px, 3vw, 40px); top: 50%; transform: translateY(-50%);
      z-index: 200; display: flex; flex-direction: column; gap: 24px;
      opacity: 0; visibility: hidden; transition: opacity 0.6s var(--ease), visibility 0.6s;
    }
    .page-nav.visible { opacity: 1; visibility: visible; }
    .page-nav-item {
      display: flex; align-items: center; gap: 12px; flex-direction: row-reverse;
      cursor: pointer; background: none; border: none; padding: 8px 0;
    }
    .page-nav-dot {
      width: 8px; height: 8px; border-radius: 50%; background: rgba(240,235,225,0.2);
      transition: all 0.35s; flex-shrink: 0; border: 1px solid transparent;
    }
    .page-nav-label {
      font-family: var(--serif-en); font-size: 11px; letter-spacing: 0.15em;
      color: rgba(240,235,225,0.4); text-transform: uppercase; transition: color 0.35s; white-space: nowrap;
    }
    .page-nav-item:hover .page-nav-dot, .page-nav-item.active .page-nav-dot {
      background: var(--gold); transform: scale(1.4); box-shadow: 0 0 10px rgba(184,149,90,0.6);
    }
    .page-nav-item:hover .page-nav-label { color: rgba(240,235,225,0.85); }
    .page-nav-item.active .page-nav-label { color: var(--gold); }

    /* ─── Hero ───────────────────────────────────────── */
    .hero { position: relative; width: 100%; height: 100svh; min-height: 600px; overflow: hidden; display: flex; align-items: flex-end; }
    .hero__bg {
      position: absolute; inset: 0; background-image: url('img/exhibition-nagano/0003.jpg'); background-size: cover; background-position: center 30%;
      transform: scale(1.04); transition: transform 12s ease;
    }
    .hero__bg.loaded { transform: scale(1.0); }
    .hero__veil { position: absolute; inset: 0; background: linear-gradient(to top, rgba(8,8,8,0.96) 0%, rgba(8,8,8,0.55) 40%, rgba(8,8,8,0.15) 70%, rgba(8,8,8,0.05) 100%); }
    .hero__content { position: relative; z-index: 2; padding: 0 var(--px) 80px; max-width: 980px; }

    @keyframes textBlurReveal { 0% { opacity: 0; filter: blur(12px); transform: translateY(12px) scale(1.02); } 100% { opacity: 1; filter: blur(0); transform: translateY(0) scale(1); } }

    .hero__eyebrow { font-family: var(--serif-en); font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); margin-bottom: 20px; display: flex; align-items: center; gap: 16px; opacity: 0; animation: textBlurReveal 2s cubic-bezier(0.2, 0.8, 0.2, 1) 0.3s forwards; }
    .hero__eyebrow::before { content: ''; display: block; width: 32px; height: 1px; background: var(--gold-dim); }
    .hero__title-jp { font-family: var(--serif-jp); font-weight: 200; font-size: clamp(2rem, 4vw, 3.2rem); letter-spacing: 0.08em; line-height: 1.3; color: rgba(240,235,225,0.95); margin-bottom: 10px; opacity: 0; animation: textBlurReveal 2.4s cubic-bezier(0.2, 0.8, 0.2, 1) 0.6s forwards; }
    .hero__title-en { font-family: var(--serif-en); font-weight: 300; font-style: italic; font-size: clamp(1rem, 1.8vw, 1.4rem); color: var(--text-dim); letter-spacing: 0.05em; margin-bottom: 32px; opacity: 0; animation: textBlurReveal 2.4s cubic-bezier(0.2, 0.8, 0.2, 1) 0.9s forwards; }
    .hero__meta { display: flex; flex-wrap: wrap; gap: 20px 40px; opacity: 0; animation: textBlurReveal 2s cubic-bezier(0.2, 0.8, 0.2, 1) 1.2s forwards; }
    .hero__meta-item { display: flex; flex-direction: column; gap: 4px; }
    .hero__meta-label { font-family: var(--serif-en); font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-dim); }
    .hero__meta-value { font-family: var(--serif-jp); font-size: 0.82rem; font-weight: 300; color: var(--text-dim); letter-spacing: 0.06em; }

    .scroll-cue { position: absolute; bottom: 36px; right: var(--px); z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 10px; opacity: 0; animation: textBlurReveal 2s ease 1.8s forwards; }
    .scroll-cue__label { font-family: var(--serif-en); font-size: 0.55rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--text-faint); writing-mode: vertical-rl; }
    .scroll-cue__line { width: 1px; height: 48px; background: linear-gradient(to bottom, var(--gold-dim), transparent); animation: scrollPulse 2.2s ease infinite; }
    @keyframes scrollPulse { 0%,100% { opacity: 0.3; transform: scaleY(1); } 50% { opacity: 0.9; transform: scaleY(1.1); } }

    /* ─── Layout & Overview ───────────────────────────── */
    .container { max-width: 1216px; margin: 0 auto; padding: 0 var(--px); }
    .container--narrow { max-width: 900px; margin: 0 auto; padding: 0 var(--px); }

    .overview { padding: 120px 0 80px; border-bottom: 1px solid var(--border); }
    .overview__badge { display: inline-flex; align-items: center; gap: 10px; border: 1px solid var(--gold-dim); padding: 6px 18px; margin-bottom: 52px; font-family: var(--serif-jp); font-size: 0.7rem; font-weight: 300; color: var(--gold); letter-spacing: 0.08em; }
    .overview__badge svg { width: 14px; height: 14px; fill: none; stroke: var(--gold); stroke-width: 1.5; }
    .overview__body { display: grid; grid-template-columns: 1fr 1fr; gap: 60px 80px; }
    .overview__text-block p { font-size: 0.9rem; line-height: 2; color: var(--text-dim); letter-spacing: 0.04em; margin-bottom: 1.2em; }
    .overview__text-block p.lead { font-size: 1rem; color: var(--text); font-weight: 400; }
    .overview__specs { display: flex; flex-direction: column; gap: 0; border-left: 1px solid var(--border); padding-left: 40px; }
    .spec-row { display: grid; grid-template-columns: 100px 1fr; gap: 12px; padding: 16px 0; border-bottom: 1px solid rgba(184,149,90,0.08); }
    .spec-row:last-child { border-bottom: none; }
    .spec-label { font-family: var(--serif-en); font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold-dim); padding-top: 3px; }
    .spec-value { font-family: var(--serif-jp); font-size: 0.82rem; font-weight: 300; color: var(--text-dim); line-height: 1.7; }

    /* ─── Pull Quote ──────────────────────────────────── */
    .pull-quote { padding: 100px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); text-align: center; }
    .pull-quote__mark { font-family: var(--serif-en); font-size: 4rem; line-height: 0.6; color: var(--gold-dim); margin-bottom: 32px; }
    .pull-quote__text { font-family: var(--serif-jp); font-weight: 200; font-size: clamp(1.2rem, 2.4vw, 1.8rem); line-height: 2; color: rgba(240,235,225,0.9); letter-spacing: 0.06em; max-width: 100%; margin: 0 auto; overflow-wrap: break-word; word-break: auto-phrase; display: inline-block; text-align: center; }
    .pull-quote__text span { display: inline-block; }

    /* ─── Story-driven Layouts (Editorial Blocks) ─────── */
    .floor-section { padding: 120px 0; border-bottom: 1px solid var(--border); position: relative; }
    .floor-header { display: flex; align-items: flex-start; gap: 48px; margin-bottom: 80px; }
    .floor-number { font-family: var(--serif-en); font-weight: 300; font-size: clamp(4rem, 8vw, 7rem); line-height: 1; color: rgba(184,149,90,0.12); letter-spacing: -0.02em; flex-shrink: 0; user-select: none; position: relative; top: -8px; }
    .floor-label { font-family: var(--serif-en); font-size: 0.62rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; display: flex; align-items: center; gap: 14px; }
    .floor-label::after { content: ''; display: block; flex: 1; max-width: 48px; height: 1px; background: var(--gold-dim); }
    .floor-title { font-family: var(--serif-jp); font-weight: 200; font-size: clamp(1.4rem, 2.8vw, 2.2rem); letter-spacing: 0.06em; color: rgba(240,235,225,0.95); margin-bottom: 20px; line-height: 1.4; }
    .floor-desc { font-size: 0.95rem; line-height: 2; color: var(--text-dim); letter-spacing: 0.04em; max-width: 680px; }

    /* 1. Full Bleed (画面いっぱい) */
    .full-bleed {
      width: 100vw; position: relative; left: 50%; right: 50%;
      margin-left: -50vw; margin-right: -50vw; margin-bottom: 100px;
    }
    .full-bleed .photo-frame { height: clamp(350px, 50vw, 750px); width: 100%; border-radius: 0; }

    /* 2. Asymmetric Grid (非対称配置) */
    .asym-grid { display: grid; grid-template-columns: 6fr 5fr; gap: 6vw; align-items: center; margin: 100px 0; }
    .asym-grid--rev { grid-template-columns: 5fr 6fr; }
    .asym-content { flex: 1; }
    .asym-media { display: flex; flex-direction: column; gap: 16px; }
    
    /* 3. Overlap Block (重なり配置) */
    .overlap-block { position: relative; margin: 120px 0; display: flex; flex-direction: column; align-items: flex-end; }
    .overlap-block--rev { align-items: flex-start; }
    .overlap-media { width: 75%; height: clamp(300px, 40vw, 550px); z-index: 1; }
    .overlap-text {
      width: 50%; background: rgba(12,12,12,0.95); backdrop-filter: blur(8px);
      padding: clamp(32px, 4vw, 56px); border: 1px solid var(--border);
      position: relative; margin-top: -120px; z-index: 2; align-self: flex-start;
      box-shadow: 0 20px 40px rgba(0,0,0,0.8);
    }
    .overlap-block--rev .overlap-text { align-self: flex-end; margin-top: -80px; }

    /* Typography inside blocks */
    .block-title { font-family: var(--serif-jp); font-size: clamp(1.2rem, 2vw, 1.6rem); font-weight: 200; color: var(--text); margin-bottom: 24px; letter-spacing: 0.05em; line-height: 1.4; }
    .block-text { font-size: 0.9rem; line-height: 2.1; color: var(--text-dim); margin-bottom: 1.2em; letter-spacing: 0.04em; }
    .block-text:last-child { margin-bottom: 0; }

    /* Generic Photo utilities */
    .photo-frame { overflow: hidden; cursor: zoom-in; background: var(--surface); position: relative; }
    .photo-frame img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.5s ease; opacity: 0; }
    .photo-frame img.loaded { opacity: 1; }
    .photo-frame:hover img { transform: scale(1.04); }
    .photo-frame::after { content: ''; position: absolute; inset: 0; border: 1px solid rgba(184,149,90,0); transition: border-color 0.3s; pointer-events: none; z-index: 1; }
    .photo-frame:hover::after { border-color: rgba(184,149,90,0.3); }

    .grid-2-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    
    .caption-row { display: flex; justify-content: space-between; align-items: baseline; padding-top: 24px; margin-top: 40px; border-top: 1px solid rgba(184,149,90,0.08); }
    .caption-row__text { font-family: var(--serif-jp); font-size: 0.72rem; font-weight: 300; color: var(--text-faint); letter-spacing: 0.06em; }
    .caption-row__count { font-family: var(--serif-en); font-size: 0.6rem; letter-spacing: 0.15em; color: var(--gold-dim); }

    /* ─── Contact ─────────────────────────────────────── */
    .contact-section { padding: clamp(7rem, 15vh, 11rem) var(--px); text-align: center; border-top: 0.5px solid var(--border); background: radial-gradient(circle at center, rgba(184,149,90,0.06) 0%, var(--bg) 70%); }
    .contact-label { font-family: var(--serif-en); font-size: clamp(0.54rem, 1.2vw, 0.61rem); letter-spacing: 0.44em; color: var(--text-dim); text-transform: uppercase; margin-bottom: 1.5rem; }
    .contact-heading { font-family: var(--serif-jp); font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 200; line-height: 1.2; color: var(--text); margin-bottom: 1.8rem; letter-spacing: 0.05em; }
    .contact-body-text { font-family: var(--serif-jp); font-size: clamp(0.85rem, 1.8vw, 0.95rem); color: var(--text-dim); margin: 0 auto 3rem; max-width: 450px; line-height: 2.2; }
    .contact-btn { display: inline-block; padding: 1.2rem 3.5rem; background: var(--gold); color: var(--bg); font-family: var(--serif-en); font-size: clamp(0.6rem, 1.4vw, 0.72rem); font-weight: 500; letter-spacing: 0.25em; text-transform: uppercase; text-decoration: none; transition: all 0.4s var(--ease); border-radius: 2px; }
    .contact-btn:hover { background: var(--text); transform: translateY(-3px); box-shadow: 0 12px 30px rgba(184,149,90,0.3); }

    /* ─── Footer ──────────────────────────────────────── */
    footer { padding: clamp(4rem, 8vh, 6rem) var(--px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.8rem; border-top: 0.5px solid var(--border); background: var(--bg); }
    .footer-logo { font-family: var(--serif-en); font-size: clamp(0.9rem, 2vw, 1.1rem); font-weight: 300; color: var(--gold); letter-spacing: 0.25em; text-transform: uppercase; text-decoration: none; }
    .footer-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(1.5rem, 4vw, 3rem); list-style: none; }
    .footer-nav a { font-family: var(--serif-en); font-size: clamp(0.6rem, 1.2vw, 0.7rem); letter-spacing: 0.2em; color: var(--text-dim); text-transform: uppercase; transition: color 0.3s; text-decoration: none; }
    .footer-nav a:hover { color: var(--gold); }
    .footer-copy { font-family: var(--serif-en); font-size: clamp(0.55rem, 1.2vw, 0.65rem); letter-spacing: 0.15em; color: var(--text-faint); margin-top: 1rem; }

    /* ─── Back to Top Button ──────────────────────────── */
    .back-to-top {
      position: fixed; bottom: clamp(1.5rem, 5vh, 4rem); right: clamp(15px, 4vw, 50px);
      z-index: 9000; width: clamp(56px, 8vw, 76px); height: clamp(56px, 8vw, 76px); border-radius: 50%;
      background: rgba(184,149,90, 0.85); border: 1px solid var(--gold); backdrop-filter: blur(8px);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      color: var(--bg); opacity: 0; visibility: hidden; transform: translateY(20px);
      transition: all 0.4s var(--ease); cursor: pointer; box-shadow: 0 10px 28px rgba(0, 0, 0, 0.6);
      text-decoration: none;
    }
    .back-to-top.is-visible { opacity: 1; visibility: visible; transform: translateY(0); }
    .back-to-top:hover { background: var(--text); color: var(--bg); border-color: var(--text); transform: translateY(-6px); }
    .back-to-top svg { width: clamp(18px, 3vw, 24px); height: clamp(18px, 3vw, 24px); margin-bottom: 2px; }
    .back-to-top-text { font-family: var(--serif-en); font-size: clamp(0.55rem, 1.2vw, 0.7rem); font-weight: 600; text-transform: uppercase; line-height: 1; letter-spacing: 0.1em; }

    /* ─── Lightbox ────────────────────────────────────── */
    .lightbox { display: none; position: fixed; inset: 0; z-index: 9999; background: rgba(4,4,4,0.96); justify-content: center; align-items: center; }
    .lightbox.active { display: flex; }
    .lightbox__inner { position: relative; max-width: 92vw; max-height: 90vh; }
    .lightbox__img { max-width: 92vw; max-height: 86vh; object-fit: contain; display: block; }
    .lightbox__close { position: absolute; top: -44px; right: 0; background: none; border: none; cursor: pointer; color: var(--text-dim); font-family: var(--serif-en); font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; display: flex; align-items: center; gap: 8px; transition: color 0.2s; }
    .lightbox__close:hover { color: var(--gold); }
    .lightbox__close svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.5; }
    .lightbox__nav { position: absolute; top: 50%; transform: translateY(-50%); background: none; border: 1px solid var(--border); padding: 12px; cursor: pointer; color: var(--text-dim); transition: border-color 0.3s, color 0.3s; }
    .lightbox__nav:hover { border-color: var(--gold-dim); color: var(--gold); }
    .lightbox__nav svg { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 1.2; display: block; }
    .lightbox__prev { left: -56px; }
    .lightbox__next { right: -56px; }
    .lightbox__caption { position: absolute; bottom: -36px; left: 0; right: 0; text-align: center; font-family: var(--serif-jp); font-size: 0.7rem; color: var(--text-faint); letter-spacing: 0.06em; }

    /* ─── Responsive & Overlay ─── */
    @media (max-width: 900px) {
      .asym-grid, .asym-grid--rev { grid-template-columns: 1fr; gap: 40px; margin: 60px 0; }
      .asym-grid--rev .asym-content { grid-row: 1; }
      .overlap-block { align-items: center; margin: 80px 0; }
      .overlap-media { width: 100%; }
      .overlap-text { width: 90%; margin-top: -60px; padding: 32px 24px; align-self: center; }
      .overlap-block--rev .overlap-text { margin-top: -60px; align-self: center; }
      .full-bleed { margin-bottom: 60px; }
    }
    @media (max-width: 768px) {
      nav#top-nav { padding: 1rem var(--px); }
      .nav-hamburger { display: block !important; }
      .nav-cta { display: none; }
      .nav-links {
        position: fixed; top: 0; left: 0; width: 100%; height: 100svh; background: rgba(8, 8, 8, 0.98);
        backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); flex-direction: column; justify-content: center; align-items: center; gap: 3rem;
        opacity: 0; visibility: hidden; transition: opacity 0.4s ease, visibility 0.4s; z-index: 1000;
      }
      .nav-links.open { opacity: 1; visibility: visible; display: flex !important; }
      .nav-links a { font-size: 1.2rem; letter-spacing: 0.25em; }
      .overview__body { grid-template-columns: 1fr; }
